NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://aura:aura_secret@127.0.0.1:55432/auraai?schema=public

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

BCRYPT_ROUNDS=12
LOG_LEVEL=info

# Redis reserved for future session / rate-limit store
REDIS_URL=redis://localhost:6379

# Google OAuth (Sign in with Google) — Web application Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# AI-inferred product ingredient/composition lookup. Optional — feature no-ops (status stays
# 'failed', logged) until these are set. Expects an OpenAI-compatible chat/completions endpoint.
INGREDIENT_AI_BASE_URL=
INGREDIENT_AI_API_KEY=
INGREDIENT_AI_MODEL=gpt-4o-mini
